# VITE_DEMO_MODE: Enable evaluation sandbox persona switcher banner and instant demo personas in production builds ('true' | 'false').
# In development (import.meta.env.DEV), the banner and personas are always visible.
VITE_DEMO_MODE="false"

# CARTO Basemap API Key (required for raster basemap tiles)
# Obtain a free key at https://carto.com
VITE_CARTO_API_KEY=
